<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
    Droits par filière d'export.

    Règles de GROUPE : Odoo réunit (OU) celles des groupes de l'utilisateur.
      * « aucune filière » (utilisateurs internes) : rien — un utilisateur
        sans filière ne voit aucun document d'export ;
      * « filière fèves » : les documents de fèves ;
      * « filière semi-finis » : les documents de semi-finis (et ceux sans
        type, antérieurs aux filières).
    Un utilisateur des deux filières voit tout. Les règles de société du
    socle (globales) restent en vigueur : elles se cumulent (ET).

    Une CV « Tous produits » est visible des deux filières (elle ne sert
    qu'une seule filière : contrainte sur les formules). Les modèles qui
    peuvent mêler les deux filières (paiements groupés, factures de
    transitaire, conteneurs, notes de débit) n'ont pas de règle de filière.
    -->
    <record id="module_category_export_family" model="ir.module.category">
        <field name="name">Filières d'export</field>
        <field name="description">Filières dont l'utilisateur voit les documents d'export.</field>
        <field name="sequence">31</field>
    </record>

    <record id="group_bean_export_beans" model="res.groups">
        <field name="name">Filière fèves</field>
        <field name="category_id" ref="module_category_export_family"/>
        <field name="comment">Voit et traite les documents d'export de fèves de cacao.</field>
    </record>

    <!-- Ancien groupe technique « semi-finis visibles » : devient la filière -->
    <record id="group_bean_export_semi_finished" model="res.groups">
        <field name="name">Filière semi-finis</field>
        <field name="category_id" ref="module_category_export_family"/>
        <field name="comment">Voit et traite les documents d'export de masse, beurre, cake et poudre.</field>
    </record>

