<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Groupe technique : accordé à tous les utilisateurs internes quand la
         société exporte aussi des semi-finis (réglage), retiré sinon. Il
         porte les filtres de recherche « Masse / Beurre / Cake / Poudre ». -->
    <record id="group_bean_export_semi_finished" model="res.groups">
        <field name="name">Export : semi-finis visibles</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>

    <record id="rule_bean_export_batch_company" model="ir.rule">
        <field name="name">Lots d'usinage : sociétés autorisées</field>
        <field name="model_id" ref="model_cocoa_bean_export_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_bean_export_document_company" model="ir.rule">
        <field name="name">Documents d'export : sociétés autorisées</field>
        <field name="model_id" ref="model_cocoa_bean_export_document"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_bean_export_document_type_company" model="ir.rule">
        <field name="name">Types de document d'export : sociétés autorisées</field>
        <field name="model_id" ref="model_cocoa_bean_export_document_type"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_bean_export_claim_company" model="ir.rule">
        <field name="name">Réclamations à l'arrivée : sociétés autorisées</field>
        <field name="model_id" ref="model_cocoa_bean_export_claim"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
