<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cocoa_bean_export_document_type_view_tree" model="ir.ui.view">
        <field name="name">cocoa.bean.export.document.type.tree</field>
        <field name="model">cocoa.bean.export.document.type</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="requirement"/>
                <field name="requires_attachment"/>
                <field name="validity_days"/>
                <field name="certified_only"/>
                <field name="eu_only"/>
                <field name="issuer" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <record id="action_cocoa_bean_export_document_type" model="ir.actions.act_window">
        <field name="name">Documents d'export des fèves</field>
        <field name="res_model">cocoa.bean.export.document.type</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ajouter un type de document</p>
            <p>Chaque type dit quand il est exigé (confirmation du BL ou de la
               facture), s'il faut joindre la pièce et sa durée de validité
               avant l'embarquement.</p>
        </field>
    </record>

    <record id="potting_delivery_note_view_form_bean_documents" model="ir.ui.view">
        <field name="name">potting.delivery.note.form.bean.documents</field>
        <field name="model">potting.delivery.note</field>
        <field name="inherit_id" ref="potting_management.potting_delivery_note_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='documents']" position="before">
                <page string="📄 Documents d'export" name="bean_export_documents"
                      invisible="product_type != 'cocoa_beans'">
                    <field name="bean_documents_complete" invisible="1"/>
                    <div class="alert alert-success mb-2" role="status"
                         invisible="not bean_documents_complete">
                        Documents exigés complets (<field name="bean_documents_summary" readonly="1" nolabel="1" class="d-inline"/>).
                    </div>
                    <div class="alert alert-warning mb-2" role="alert"
                         invisible="bean_documents_complete">
                        Documents exigés incomplets : la confirmation du BL ou de la facture
                        sera refusée tant qu'ils manquent.
                    </div>
                    <button name="action_bean_documents_sync" type="object"
                            string="Ajouter les documents manquants" class="btn-link"/>
                    <field name="bean_document_ids">
                        <tree editable="bottom" decoration-danger="status in ('missing', 'expired')"
                              decoration-warning="status == 'incomplete'"
                              decoration-success="status == 'ok'">
                            <field name="type_id" options="{'no_create': True}"/>
                            <field name="requirement"/>
                            <field name="number"/>
                            <field name="date"/>
                            <field name="issuer" optional="show"/>
                            <field name="attachment_ids" widget="many2many_binary"/>
                            <field name="status" widget="badge"
                                   decoration-danger="status in ('missing', 'expired')"
                                   decoration-warning="status == 'incomplete'"
                                   decoration-success="status == 'ok'"/>
                            <field name="status_detail" optional="show"/>
                            <field name="note" optional="hide"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
