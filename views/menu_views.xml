              parent="potting_management.menu_potting_production"
              action="action_cocoa_bean_export_batch_import"
              sequence="6"
              groups="potting_management.group_potting_shipping,potting_management.group_potting_manager"/>

    <menuitem id="menu_cocoa_bean_export_claim"
              name="Réclamations à l'arrivée"
              parent="potting_management.menu_potting_logistics"
              action="action_cocoa_bean_export_claim"
              sequence="45"
              groups="potting_management.group_potting_shipping,potting_management.group_potting_bl_manager,potting_management.group_potting_accountant"/>

    <menuitem id="menu_bean_export_help_guide"
              name="Guide Export des fèves"
