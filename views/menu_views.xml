              name="Lots d'usinage"
              parent="potting_management.menu_potting_production"
              action="action_cocoa_bean_export_batch"
              sequence="5"
              groups="potting_management.group_potting_shipping,potting_management.group_potting_production,potting_management.group_potting_container_manager"/>

    <menuitem id="menu_cocoa_bean_export_batch_import"
