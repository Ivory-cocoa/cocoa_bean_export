<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="product_category_cocoa_beans" model="product.category">
            <field name="name">Fèves de cacao</field>
        </record>

        <record id="product_cocoa_beans" model="product.product">
            <field name="name">Fèves de cacao</field>
            <field name="default_code">FEVES</field>
            <field name="type">consu</field>
            <field name="categ_id" ref="product_category_cocoa_beans"/>
            <field name="potting_product_type">cocoa_beans</field>
            <field name="uom_id" ref="uom.product_uom_ton"/>
            <field name="uom_po_id" ref="uom.product_uom_ton"/>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
        </record>
    </data>
</odoo>
