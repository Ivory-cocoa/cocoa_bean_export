<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Documents usuels d'une expédition de fèves. Exigences et validités
         sont des valeurs de départ, à ajuster dans Configuration ▸ Documents
         d'export des fèves (noupdate : vos réglages ne sont jamais écrasés). -->
    <data noupdate="1">
        <record id="doc_type_phyto" model="cocoa.bean.export.document.type">
            <field name="name">Certificat phytosanitaire</field>
            <field name="code">PHYTO</field>
            <field name="sequence">10</field>
            <field name="requirement">invoice</field>
            <field name="requires_attachment" eval="True"/>
            <field name="issuer">Ministère de l'Agriculture</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="doc_type_fumigation" model="cocoa.bean.export.document.type">
            <field name="name">Certificat de fumigation</field>
            <field name="code">FUMIG</field>
            <field name="sequence">20</field>
            <field name="requirement">invoice</field>
            <field name="requires_attachment" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>
        <record id="doc_type_origin" model="cocoa.bean.export.document.type">
            <field name="name">Certificat d'origine</field>
            <field name="code">ORIGIN</field>
            <field name="sequence">30</field>
            <field name="requirement">invoice</field>
            <field name="requires_attachment" eval="True"/>
            <field name="issuer">Chambre de Commerce et d'Industrie de Côte d'Ivoire</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="doc_type_quality" model="cocoa.bean.export.document.type">
            <field name="name">Certificat de qualité (CCC)</field>
            <field name="code">QUALITY</field>
            <field name="sequence">40</field>
            <field name="requirement">invoice</field>
            <field name="requires_attachment" eval="True"/>
            <field name="issuer">Conseil du Café-Cacao</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="doc_type_weight" model="cocoa.bean.export.document.type">
            <field name="name">Certificat de poids</field>
            <field name="code">WEIGHT</field>
            <field name="sequence">50</field>
            <field name="requirement">optional</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="doc_type_transaction" model="cocoa.bean.export.document.type">
            <field name="name">Certificat de transaction (certification)</field>
            <field name="code">TC</field>
            <field name="sequence">60</field>
            <field name="requirement">optional</field>
            <field name="certified_only" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
